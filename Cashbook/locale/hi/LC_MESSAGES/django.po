msgstr "पूरी कैशबुक में मुद्रा दिखाने का तरीका चुनें।"

msgid "Currency display"
msgstr "मुद्रा प्रदर्शन"

msgid "Currency symbol"
msgstr "मुद्रा चिह्न"

msgid "Currency code"
msgstr "मुद्रा कोड"

msgid "Use the symbol or ISO currency code before each amount."
msgstr "हर राशि से पहले मुद्रा चिह्न या ISO मुद्रा कोड इस्तेमाल करें।"

msgid "Save currency format"
msgstr "मुद्रा प्रारूप सहेजें"

msgid "Your currency format preference has been saved."
msgstr "आपकी मुद्रा प्रारूप पसंद सहेज ली गई है।"
